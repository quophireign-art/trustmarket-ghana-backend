{
  "name": "MonetizationProfile",
  "type": "object",
  "properties": {
    "seller_email": {
      "type": "string",
      "description": "Seller/creator email"
    },
    "followers": {
      "type": "number",
      "default": 0,
      "description": "Genuine follower count"
    },
    "monetization_enabled": {
      "type": "boolean",
      "default": false
    },
    "policy_violations": {
      "type": "boolean",
      "default": false,
      "description": "Flagged for major policy violations"
    },
    "reward_level": {
      "type": "string",
      "enum": [
        "none",
        "rising",
        "verified",
        "creator",
        "gold",
        "platinum",
        "diamond",
        "legend"
      ],
      "default": "none"
    },
    "subscription_price": {
      "type": "number",
      "default": 5,
      "description": "Monthly subscriber price in GHS"
    },
    "subscriber_count": {
      "type": "number",
      "default": 0
    },
    "gift_earnings": {
      "type": "number",
      "default": 0
    },
    "ad_earnings": {
      "type": "number",
      "default": 0
    },
    "subscription_earnings": {
      "type": "number",
      "default": 0
    },
    "affiliate_earnings": {
      "type": "number",
      "default": 0
    },
    "sponsored_earnings": {
      "type": "number",
      "default": 0
    },
    "digital_sales_earnings": {
      "type": "number",
      "default": 0
    },
    "pay_to_message_earnings": {
      "type": "number",
      "default": 0
    },
    "referral_earnings": {
      "type": "number",
      "default": 0
    },
    "payout_method": {
      "type": "string",
      "enum": [
        "mtn_momo",
        "telecel_cash",
        "bank_transfer"
      ]
    },
    "payout_number": {
      "type": "string",
      "description": "Phone or account number for payouts"
    }
  },
  "required": [
    "seller_email"
  ]
}