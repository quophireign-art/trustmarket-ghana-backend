{
  "name": "Property",
  "type": "object",
  "properties": {
    "title": { "type": "string", "description": "Property listing title" },
    "description": { "type": "string", "description": "Property description" },
    "price": { "type": "number", "description": "Price in GHS" },
    "negotiable": { "type": "boolean", "default": true },
    "category": { "type": "string", "enum": ["new_builds", "rent_houses", "sale_houses", "short_let", "rent_land", "sale_land", "event_venues", "rent_commercial", "sale_commercial"], "description": "Property category" },
    "subcategory": { "type": "string", "description": "Property subcategory" },
    "property_type": { "type": "string", "description": "Property type" },
    "listing_type": { "type": "string", "enum": ["rent", "sale", "short_let"], "description": "Listing type" },
    "bedrooms": { "type": "number", "description": "Number of bedrooms" },
    "bathrooms": { "type": "number", "description": "Number of bathrooms" },
    "toilets": { "type": "number", "description": "Number of toilets" },
    "property_size": { "type": "string", "description": "Property size (sq ft/m)" },
    "land_size": { "type": "string", "description": "Land size (sq ft/m or acres)" },
    "year_built": { "type": "number", "description": "Year built" },
    "floor_number": { "type": "number", "description": "Floor number" },
    "total_floors": { "type": "number", "description": "Total floors in building" },
    "furnished": { "type": "boolean", "default": false },
    "parking_spaces": { "type": "number", "description": "Parking spaces" },
    "amenities": { "type": "array", "items": { "type": "string" }, "description": "Amenities list" },
    "country": { "type": "string", "default": "Ghana" },
    "region": { "type": "string", "description": "Region" },
    "city": { "type": "string", "description": "City" },
    "town": { "type": "string", "description": "Town" },
    "community": { "type": "string", "description": "Community/Area" },
    "gps_address": { "type": "string", "description": "GPS Address" },
    "map_location": { "type": "string", "description": "Map coordinates" },
    "seller_type": { "type": "string", "enum": ["owner", "agent", "agency"], "description": "Seller type" },
    "agency_name": { "type": "string", "description": "Agency name" },
    "seller_name": { "type": "string", "description": "Seller display name" },
    "seller_email": { "type": "string", "description": "Seller email" },
    "contact_phone": { "type": "string", "description": "Contact phone" },
    "whatsapp": { "type": "string", "description": "WhatsApp number" },
    "verified_agent": { "type": "boolean", "default": false },
    "images": { "type": "array", "items": { "type": "string" }, "description": "Property photos (up to 30)" },
    "videos": { "type": "array", "items": { "type": "string" }, "description": "Property videos (up to 5)" },
    "virtual_tour": { "type": "string", "description": "360 Virtual Tour URL" },
    "floor_plan": { "type": "string", "description": "Floor plan URL" },
    "ownership_documents": { "type": "boolean", "default": false },
    "land_title": { "type": "boolean", "default": false },
    "survey_plan": { "type": "boolean", "default": false },
    "inspection_report": { "type": "string", "description": "Inspection report URL" },
    "verified_property": { "type": "boolean", "default": false },
    "status": { "type": "string", "enum": ["active", "rented", "sold", "removed", "pending", "expired"], "default": "active" },
    "expires_at": { "type": "string", "description": "ISO timestamp when listing expires" },
    "views_count": { "type": "number", "default": 0 },
    "trust_score": { "type": "number", "default": 0 },
    "featured": { "type": "boolean", "default": false },
    "created_at": { "type": "string", "description": "Creation timestamp" }
  },
  "required": ["title", "price", "category", "region", "city"]
}
