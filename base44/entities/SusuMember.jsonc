{
  "name": "SusuMember",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "ghana_card_name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "region": {
      "type": "string"
    },
    "district": {
      "type": "string"
    },
    "community": {
      "type": "string"
    },
    "business_certificate_url": {
      "type": "string"
    },
    "passport_photo_url": {
      "type": "string"
    },
    "ghana_card_video_url": {
      "type": "string"
    },
    "momo_number": {
      "type": "string"
    },
    "momo_linked_to_ghana_card": {
      "type": "boolean",
      "default": false
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "relationship": {
            "type": "string"
          }
        }
      }
    },
    "category": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C"
      ],
      "description": "Single-person savings plan: A=50/day, B=500/day, C=5000/day"
    },
    "daily_amount": {
      "type": "number",
      "description": "Fixed daily contribution in GHS based on the chosen category"
    },
    "susu_id": {
      "type": "string",
      "description": "Unique ID e.g. TMGSUSU-2026-GAR"
    },
    "contribution_amount": {
      "type": "number",
      "description": "Daily contribution amount (mirrors daily_amount for backward compatibility)"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "completed"
      ],
      "default": "active"
    },
    "total_contributed": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "user_email",
    "full_name",
    "phone",
    "region",
    "momo_number",
    "category",
    "daily_amount"
  ]
}