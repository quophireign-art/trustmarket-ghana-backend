{
  "title": "RepairService",
  "description": "Repair services for homes, electronics, vehicles and appliances in Ghana",
  "type": "object",
  "properties": {
    "title": { "type": "string", "maxLength": 200, "required": true },
    "repairType": { "type": "string", "enum": ["Electronics Repair", "Phone & Tablet Repair", "Computer & Laptop Repair", "Appliance Repair", "Vehicle Repair", "Generator Repair", "Plumbing Repair", "Electrical Repair", "Furniture Repair", "Shoe & Bag Repair", "Watch Repair", "Jewelry Repair", "Home Renovation Repair", "Air Conditioner Repair", "Refrigerator Repair", "Washing Machine Repair", "TV Repair", "Other"], "required": true },
    "price": { "type": "number", "minimum": 0, "required": true },
    "pricingType": { "type": "string", "enum": ["Fixed", "Per Hour", "Diagnostic Fee", "Negotiable", "Quote on Request"], "default": "Fixed" },
    "warrantyOffered": { "type": "boolean", "default": false },
    "warrantyPeriod": { "type": "string", "maxLength": 100 },
    "callOutFee": { "type": "number", "minimum": 0 },
    "pickupDelivery": { "type": "boolean", "default": false },
    "location": { "type": "string", "maxLength": 200, "required": true },
    "region": { "type": "string", "maxLength": 100 },
    "serviceArea": { "type": "string", "maxLength": 500 },
    "description": { "type": "string", "maxLength": 5000 },
    "images": { "type": "array", "items": { "type": "string" } },
    "providerName": { "type": "string", "maxLength": 200, "required": true },
    "providerPhone": { "type": "string", "maxLength": 20 },
    "providerEmail": { "type": "string", "maxLength": 200 },
    "businessType": { "type": "string", "enum": ["Individual", "Company", "Workshop"], "default": "Individual" },
    "experienceYears": { "type": "number", "minimum": 0 },
    "certified": { "type": "boolean", "default": false },
    "originalParts": { "type": "boolean", "default": false },
    "availability": { "type": "string", "maxLength": 200 },
    "featured": { "type": "boolean", "default": false },
    "status": { "type": "string", "enum": ["active", "inactive", "booked"], "default": "active" },
    "listingType": { "type": "string", "enum": ["standard", "premium"], "default": "standard" }
  }
}