{
  "title": "BuildingMaterial",
  "description": "Building Materials & Construction products for sale in Ghana",
  "type": "object",
  "properties": {
    "title": { "type": "string", "maxLength": 200, "required": true },
    "category": { "type": "string", "enum": ["Cement & Concrete", "Steel & Metal", "Timber & Wood", "Bricks & Blocks", "Roofing Materials", "Plumbing & Pipes", "Electrical & Wiring", "Tiles & Flooring", "Paint & Finishes", "Doors & Windows", "Sand & Aggregates", "Construction Tools", "Scaffolding", "Safety Equipment", "Hardware & Fasteners", "Insulation", "Other"], "required": true },
    "subCategory": { "type": "string", "maxLength": 100 },
    "brand": { "type": "string", "maxLength": 100 },
    "condition": { "type": "string", "enum": ["New", "Used", "Surplus", "Refurbished"], "required": true },
    "price": { "type": "number", "minimum": 0, "required": true },
    "negotiable": { "type": "boolean", "default": false },
    "quantityAvailable": { "type": "number", "minimum": 1, "default": 1 },
    "unit": { "type": "string", "enum": ["Piece", "Bag", "Ton", "Meter", "Square Meter", "Roll", "Box", "Set", "Pack", "Liter", "Other"], "default": "Piece" },
    "bulkDiscount": { "type": "boolean", "default": false },
    "deliveryAvailable": { "type": "boolean", "default": false },
    "deliveryFee": { "type": "number", "minimum": 0 },
    "location": { "type": "string", "maxLength": 200, "required": true },
    "region": { "type": "string", "maxLength": 100 },
    "description": { "type": "string", "maxLength": 5000 },
    "images": { "type": "array", "items": { "type": "string" } },
    "sellerName": { "type": "string", "maxLength": 200 },
    "sellerPhone": { "type": "string", "maxLength": 20 },
    "sellerEmail": { "type": "string", "maxLength": 200 },
    "sellerType": { "type": "string", "enum": ["Individual", "Retailer", "Wholesaler", "Manufacturer", "Importer"], "default": "Individual" },
    "warranty": { "type": "string", "maxLength": 200 },
    "certifications": { "type": "array", "items": { "type": "string" } },
    "featured": { "type": "boolean", "default": false },
    "status": { "type": "string", "enum": ["active", "sold", "reserved", "inactive"], "default": "active" },
    "listingType": { "type": "string", "enum": ["standard", "premium", "auction"], "default": "standard" }
  }
}