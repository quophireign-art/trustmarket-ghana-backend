{
  "name": "FoodItem",
  "type": "object",
  "properties": {
    "vendor_id": {
      "type": "string"
    },
    "vendor_email": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "image_url": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "main",
        "side",
        "drinks",
        "dessert",
        "snacks"
      ]
    },
    "is_available": {
      "type": "boolean",
      "default": true
    },
    "prep_time_minutes": {
      "type": "number",
      "default": 20
    }
  },
  "required": [
    "vendor_id",
    "vendor_email",
    "name",
    "price"
  ]
}