{
  "title": "Agriculture",
  "description": "Food, Agriculture & Farming products and equipment for sale in Ghana",
  "type": "object",
  "properties": {
    "title": { "type": "string", "maxLength": 200, "required": true },
    "category": { "type": "string", "enum": ["Fresh Produce", "Grains & Cereals", "Livestock", "Poultry", "Dairy Products", "Processed Foods", "Seeds & Seedlings", "Fertilizers", "Pesticides & Herbicides", "Farming Tools", "Farm Machinery", "Irrigation Equipment", "Animal Feed", "Aquaculture", "Honey & Beekeeping", "Organic Products", "Other"], "required": true },
    "subCategory": { "type": "string", "maxLength": 100 },
    "condition": { "type": "string", "enum": ["New", "Used", "Fresh", "Organic", "Processed"], "required": true },
    "price": { "type": "number", "minimum": 0, "required": true },
    "negotiable": { "type": "boolean", "default": false },
    "quantityAvailable": { "type": "number", "minimum": 1, "default": 1 },
    "unit": { "type": "string", "enum": ["Piece", "Kg", "Ton", "Bag", "Crate", "Box", "Dozen", "Litre", "Bunch", "Sack", "Other"], "default": "Piece" },
    "bulkDiscount": { "type": "boolean", "default": false },
    "deliveryAvailable": { "type": "boolean", "default": false },
    "harvestDate": { "type": "string", "maxLength": 50 },
    "shelfLife": { "type": "string", "maxLength": 100 },
    "location": { "type": "string", "maxLength": 200, "required": true },
    "region": { "type": "string", "maxLength": 100 },
    "farmName": { "type": "string", "maxLength": 200 },
    "description": { "type": "string", "maxLength": 5000 },
    "images": { "type": "array", "items": { "type": "string" } },
    "sellerName": { "type": "string", "maxLength": 200 },
    "sellerPhone": { "type": "string", "maxLength": 20 },
    "sellerEmail": { "type": "string", "maxLength": 200 },
    "sellerType": { "type": "string", "enum": ["Individual", "Farm", "Cooperative", "Retailer", "Wholesaler"], "default": "Individual" },
    "organic": { "type": "boolean", "default": false },
    "certified": { "type": "boolean", "default": false },
    "certifications": { "type": "array", "items": { "type": "string" } },
    "featured": { "type": "boolean", "default": false },
    "status": { "type": "string", "enum": ["active", "sold", "reserved", "inactive"], "default": "active" },
    "listingType": { "type": "string", "enum": ["standard", "premium", "auction"], "default": "standard" }
  }
}