{
  "name": "Vehicle",
  "type": "object",
  "properties": {
    "title": { "type": "string", "description": "Vehicle listing title" },
    "description": { "type": "string", "description": "Vehicle description" },
    "price": { "type": "number", "description": "Price in GHS" },
    "negotiable": { "type": "boolean", "default": true },
    "category": { "type": "string", "description": "Vehicle category", "enum": ["vehicle_parts", "cars", "motorcycles", "buses", "trucks", "construction_machinery", "watercraft", "personal_mobility", "car_services"] },
    "subcategory": { "type": "string", "description": "Vehicle subcategory" },
    "make": { "type": "string", "description": "Vehicle make/brand" },
    "model": { "type": "string", "description": "Vehicle model" },
    "year": { "type": "number", "description": "Year of manufacture" },
    "trim": { "type": "string", "description": "Trim/Edition" },
    "condition": { "type": "string", "enum": ["new", "foreign_used", "ghana_used"], "description": "Vehicle condition" },
    "mileage": { "type": "number", "description": "Mileage in km" },
    "fuel_type": { "type": "string", "enum": ["petrol", "diesel", "electric", "hybrid", "lpg"], "description": "Fuel type" },
    "transmission": { "type": "string", "enum": ["automatic", "manual", "cvt", "semi_automatic"], "description": "Transmission type" },
    "engine_size": { "type": "string", "description": "Engine capacity" },
    "drivetrain": { "type": "string", "enum": ["fwd", "rwd", "awd", "4wd"], "description": "Drivetrain" },
    "body_type": { "type": "string", "description": "Body type" },
    "num_doors": { "type": "number", "description": "Number of doors" },
    "num_seats": { "type": "number", "description": "Number of seats" },
    "exterior_color": { "type": "string", "description": "Exterior color" },
    "interior_color": { "type": "string", "description": "Interior color" },
    "vin": { "type": "string", "description": "VIN/Chassis Number (optional)" },
    "seller_type": { "type": "string", "enum": ["private", "dealer"], "description": "Seller type" },
    "business_name": { "type": "string", "description": "Business name (for dealers)" },
    "seller_name": { "type": "string", "description": "Seller display name" },
    "seller_email": { "type": "string", "description": "Seller email" },
    "contact_phone": { "type": "string", "description": "Contact phone number" },
    "whatsapp": { "type": "string", "description": "WhatsApp number" },
    "location": { "type": "string", "description": "Region, City, Town" },
    "region": { "type": "string", "description": "Region" },
    "city": { "type": "string", "description": "City" },
    "images": { "type": "array", "items": { "type": "string" }, "description": "Vehicle photos (up to 20)" },
    "videos": { "type": "array", "items": { "type": "string" }, "description": "Vehicle videos (up to 3)" },
    "photos_360": { "type": "array", "items": { "type": "string" }, "description": "360 photos (optional)" },
    "inspection_report": { "type": "string", "description": "Inspection report URL" },
    "verified_seller": { "type": "boolean", "default": false },
    "warranty_available": { "type": "boolean", "default": false },
    "trade_in_accepted": { "type": "boolean", "default": false },
    "delivery_available": { "type": "boolean", "default": false },
    "service_history": { "type": "string", "description": "Service history notes" },
    "accident_history": { "type": "string", "description": "Accident history notes" },
    "original_documents": { "type": "boolean", "default": false },
    "status": { "type": "string", "enum": ["active", "sold", "removed", "pending", "expired"], "default": "active" },
    "expires_at": { "type": "string", "description": "ISO timestamp when listing expires" },
    "views_count": { "type": "number", "default": 0 },
    "trust_score": { "type": "number", "default": 0 },
    "featured": { "type": "boolean", "default": false },
    "created_at": { "type": "string", "description": "Creation timestamp" }
  },
  "required": ["title", "price", "category", "make", "model", "condition"]
}
