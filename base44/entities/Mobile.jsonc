{
  "name": "Mobile",
  "type": "object",
  "properties": {
    "title": { "type": "string", "description": "Product listing title" },
    "description": { "type": "string", "description": "Product description" },
    "price": { "type": "number", "description": "Price in GHS" },
    "negotiable": { "type": "boolean", "default": true },
    "category": { "type": "string", "enum": ["mobile_phones", "accessories", "smart_watches", "tablets", "headphones"], "description": "Mobile category" },
    "subcategory": { "type": "string", "description": "Subcategory" },
    "brand": { "type": "string", "description": "Brand" },
    "model": { "type": "string", "description": "Model" },
    "condition": { "type": "string", "enum": ["new", "used", "refurbished"], "description": "Condition" },
    "storage": { "type": "string", "description": "Storage Capacity" },
    "ram": { "type": "string", "description": "RAM" },
    "screen_size": { "type": "string", "description": "Screen Size" },
    "screen_resolution": { "type": "string", "description": "Screen Resolution" },
    "processor": { "type": "string", "description": "Processor" },
    "os": { "type": "string", "description": "Operating System" },
    "battery": { "type": "string", "description": "Battery Capacity" },
    "camera": { "type": "string", "description": "Camera Specifications" },
    "sim_type": { "type": "string", "enum": ["single", "dual", "esim"], "description": "SIM Type" },
    "network": { "type": "string", "description": "Network (2G/3G/4G/5G)" },
    "color": { "type": "string", "description": "Color" },
    "warranty": { "type": "boolean", "default": false },
    "seller_type": { "type": "string", "enum": ["private", "business"], "description": "Seller type" },
    "business_name": { "type": "string", "description": "Business name" },
    "seller_name": { "type": "string", "description": "Seller display name" },
    "seller_email": { "type": "string", "description": "Seller email" },
    "contact_phone": { "type": "string", "description": "Contact phone" },
    "whatsapp": { "type": "string", "description": "WhatsApp number" },
    "location": { "type": "string", "description": "Location" },
    "region": { "type": "string", "description": "Region" },
    "city": { "type": "string", "description": "City" },
    "verified_seller": { "type": "boolean", "default": false },
    "images": { "type": "array", "items": { "type": "string" }, "description": "Product photos (up to 20)" },
    "videos": { "type": "array", "items": { "type": "string" }, "description": "Product videos (up to 3)" },
    "status": { "type": "string", "enum": ["active", "sold", "removed", "pending", "expired"], "default": "active" },
    "expires_at": { "type": "string", "description": "ISO timestamp when listing expires" },
    "views_count": { "type": "number", "default": 0 },
    "trust_score": { "type": "number", "default": 0 },
    "featured": { "type": "boolean", "default": false },
    "created_at": { "type": "string", "description": "Creation timestamp" }
  },
  "required": ["title", "price", "category", "brand", "condition"]
}
