{
  "name": "Review",
  "type": "object",
  "properties": {
    "seller_email": {
      "type": "string"
    },
    "reviewer_email": {
      "type": "string"
    },
    "reviewer_name": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "description": "Rating 1-5"
    },
    "comment": {
      "type": "string"
    },
    "order_id": {
      "type": "string"
    }
  },
  "required": [
    "seller_email",
    "rating"
  ]
}