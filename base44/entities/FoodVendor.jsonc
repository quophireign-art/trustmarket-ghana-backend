{
  "name": "FoodVendor",
  "type": "object",
  "properties": {
    "owner_email": {
      "type": "string"
    },
    "restaurant_name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "banner_url": {
      "type": "string"
    },
    "cuisine_type": {
      "type": "string",
      "enum": [
        "ghanaian",
        "chinese",
        "continental",
        "fast_food",
        "grills",
        "pastries",
        "drinks",
        "other"
      ]
    },
    "is_open": {
      "type": "boolean",
      "default": true
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "suspended"
      ],
      "default": "pending"
    },
    "avg_rating": {
      "type": "number",
      "default": 0
    },
    "total_orders": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "owner_email",
    "restaurant_name",
    "location"
  ]
}