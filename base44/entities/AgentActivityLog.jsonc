{
  "name": "AgentActivityLog",
  "type": "object",
  "properties": {
    "agent_email": {
      "type": "string",
      "description": "Agent's email"
    },
    "action": {
      "type": "string",
      "enum": ["product_listed", "product_sold", "product_updated", "product_removed", "commission_earned", "commission_withdrawn", "profile_updated", "verification_step", "login", "logout"],
      "description": "Type of activity performed"
    },
    "details": {
      "type": "string",
      "description": "Human-readable details of the activity"
    },
    "metadata": {
      "type": "object",
      "description": "Additional structured data"
    },
    "created_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": ["agent_email", "action", "details"]
}
