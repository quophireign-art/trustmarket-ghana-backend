{
  "name": "Rider",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "vehicle_type": {
      "type": "string",
      "enum": [
        "motorcycle",
        "car",
        "bicycle"
      ],
      "default": "motorcycle"
    },
    "vehicle_plate": {
      "type": "string"
    },
    "region": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "busy",
        "offline"
      ],
      "default": "offline"
    },
    "current_lat": {
      "type": "number"
    },
    "current_lng": {
      "type": "number"
    },
    "total_deliveries": {
      "type": "number",
      "default": 0
    },
    "rating": {
      "type": "number",
      "default": 0
    },
    "approved": {
      "type": "boolean",
      "default": false
    },
    "ghana_card_url": {
      "type": "string"
    },
    "license_url": {
      "type": "string"
    },
    "photo_url": {
      "type": "string",
      "description": "Profile photo of the rider (shown to buyers)"
    },
    "video_url": {
      "type": "string",
      "description": "Short intro / verification video of the rider"
    },
    "payout_schedule": {
      "type": "string",
      "enum": [
        "manual",
        "weekly",
        "monthly"
      ],
      "default": "manual",
      "description": "How often accumulated commissions are auto-paid out"
    },
    "payout_day_of_month": {
      "type": "number",
      "default": 1,
      "description": "Day of month for monthly auto-payouts (1-28)"
    },
    "last_auto_payout_date": {
      "type": "string",
      "description": "ISO date of the last automatic payout"
    },
    "payout_method": {
      "type": "string",
      "enum": [
        "mtn_momo",
        "telecel_cash",
        "bank_transfer"
      ],
      "default": "mtn_momo"
    },
    "payout_number": {
      "type": "string",
      "description": "Phone or account number for automatic payouts"
    }
  },
  "required": [
    "user_email",
    "full_name",
    "phone"
  ]
}