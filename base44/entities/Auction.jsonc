{
  "name": "Auction",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string"
    },
    "product_title": {
      "type": "string"
    },
    "product_image": {
      "type": "string"
    },
    "seller_email": {
      "type": "string"
    },
    "starting_price": {
      "type": "number"
    },
    "current_price": {
      "type": "number"
    },
    "min_increment": {
      "type": "number",
      "default": 5
    },
    "ends_at": {
      "type": "string",
      "description": "ISO timestamp when auction ends"
    },
    "status": {
      "type": "string",
      "enum": [
        "upcoming",
        "live",
        "ended"
      ],
      "default": "upcoming"
    },
    "winner_email": {
      "type": "string"
    },
    "winner_name": {
      "type": "string"
    },
    "total_bids": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "product_id",
    "starting_price",
    "ends_at"
  ]
}