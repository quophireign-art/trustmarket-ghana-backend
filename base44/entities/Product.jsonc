{
  "name": "Product",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Product title"
    },
    "description": {
      "type": "string",
      "description": "Product description"
    },
    "price": {
      "type": "number",
      "description": "Price in GHS"
    },
    "category": {
      "type": "string",
      "enum": [
        "electronics",
        "fashion",
        "vehicles",
        "property",
        "phones",
        "furniture",
        "agriculture",
        "services",
        "health",
        "other"
      ],
      "description": "Product category"
    },
    "condition": {
      "type": "string",
      "enum": [
        "new",
        "used_like_new",
        "used_good",
        "used_fair"
      ],
      "default": "new"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Product image URLs"
    },
    "location": {
      "type": "string",
      "description": "Seller location in Ghana"
    },
    "seller_email": {
      "type": "string",
      "description": "Seller's email"
    },
    "seller_name": {
      "type": "string",
      "description": "Seller's display name"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "sold",
        "removed",
        "pending",
        "expired"
      ],
      "default": "active"
    },
    "expires_at": {
      "type": "string",
      "description": "ISO timestamp when the product listing expires"
    },
    "seo_title": {
      "type": "string",
      "description": "Auto-generated SEO title"
    },
    "seo_description": {
      "type": "string",
      "description": "Auto-generated SEO meta description"
    },
    "seo_keywords": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Auto-generated SEO keywords"
    },
    "trust_score": {
      "type": "number",
      "default": 0,
      "description": "Product trust score (0-100)"
    },
    "viral_score": {
      "type": "number",
      "default": 0,
      "description": "Viral momentum score"
    },
    "views_count": {
      "type": "number",
      "default": 0,
      "description": "Number of product views"
    },
    "trending_rank": {
      "type": "number",
      "default": 0,
      "description": "Current trending rank"
    },
    "negotiable": {
      "type": "boolean",
      "default": true
    },
    "track_inventory": {
      "type": "boolean",
      "default": false,
      "description": "Enable stock tracking"
    },
    "stock_quantity": {
      "type": "number",
      "default": 0,
      "description": "Current units in stock"
    },
    "low_stock_threshold": {
      "type": "number",
      "default": 5,
      "description": "Alert when stock drops below this number"
    },
    "assigned_rider_id": {
      "type": "string",
      "description": "ID of the rider assigned to deliver this product (shown to buyers)"
    }
  },
  "required": [
    "title",
    "price",
    "category"
  ]
}