{
  "name": "LiveStream",
  "type": "object",
  "properties": {
    "host_email": {
      "type": "string"
    },
    "host_name": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "live",
        "ended"
      ],
      "default": "live"
    },
    "wallet_balance": {
      "type": "number",
      "default": 0
    },
    "viewer_count": {
      "type": "number",
      "default": 0
    },
    "guests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "joined_at": {
            "type": "string"
          }
        }
      }
    },
    "multistream_platforms": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Social platforms (facebook, tiktok, instagram, youtube, snapchat, threads) this stream is also announced as live on"
    }
  },
  "required": [
    "host_email",
    "title"
  ]
}