{
  "title": "FitnessService",
  "description": "Fitness & Personal Training services in Ghana",
  "type": "object",
  "properties": {
    "title": { "type": "string", "maxLength": 200, "required": true },
    "serviceType": { "type": "string", "enum": ["Personal Training", "Group Fitness Classes", "Yoga Instruction", "Pilates", "CrossFit Coaching", "Boxing & MMA Training", "Dance Fitness", "Sports Coaching", "Nutrition Consulting", "Weight Loss Program", "Muscle Building", "Rehabilitation Training", "Online Coaching", "Gym Membership", "Other"], "required": true },
    "price": { "type": "number", "minimum": 0, "required": true },
    "pricingType": { "type": "string", "enum": ["Per Session", "Per Week", "Per Month", "Per Package", "Fixed", "Negotiable"], "default": "Per Session" },
    "negotiable": { "type": "boolean", "default": false },
    "experienceYears": { "type": "number", "minimum": 0 },
    "certifications": { "type": "array", "items": { "type": "string" } },
    "location": { "type": "string", "maxLength": 200, "required": true },
    "region": { "type": "string", "maxLength": 100 },
    "serviceArea": { "type": "string", "maxLength": 500 },
    "homeService": { "type": "boolean", "default": false },
    "gymFacility": { "type": "boolean", "default": false },
    "onlineAvailable": { "type": "boolean", "default": false },
    "description": { "type": "string", "maxLength": 5000 },
    "images": { "type": "array", "items": { "type": "string" } },
    "providerName": { "type": "string", "maxLength": 200, "required": true },
    "providerPhone": { "type": "string", "maxLength": 20 },
    "providerEmail": { "type": "string", "maxLength": 200 },
    "businessType": { "type": "string", "enum": ["Individual", "Gym", "Studio", "Company"], "default": "Individual" },
    "availability": { "type": "string", "maxLength": 200 },
    "featured": { "type": "boolean", "default": false },
    "status": { "type": "string", "enum": ["active", "inactive", "fully booked"], "default": "active" },
    "listingType": { "type": "string", "enum": ["standard", "premium"], "default": "standard" }
  }
}