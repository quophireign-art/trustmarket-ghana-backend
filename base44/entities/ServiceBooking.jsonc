{
  "name": "ServiceBooking",
  "type": "object",
  "properties": {
    "service_id": {
      "type": "string",
      "description": "ID of the service product booked"
    },
    "service_title": {
      "type": "string"
    },
    "service_price": {
      "type": "number"
    },
    "buyer_email": {
      "type": "string"
    },
    "buyer_name": {
      "type": "string"
    },
    "seller_email": {
      "type": "string"
    },
    "scheduled_date": {
      "type": "string",
      "description": "ISO date the service is scheduled for"
    },
    "location": {
      "type": "string",
      "description": "Where the service will be performed"
    },
    "linked_product_id": {
      "type": "string",
      "description": "Optional physical product this service was booked alongside"
    },
    "linked_product_title": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "completed",
        "cancelled"
      ],
      "default": "pending"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "service_id",
    "buyer_email",
    "seller_email",
    "scheduled_date"
  ]
}