{
  "name": "Wallet",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "balance": {
      "type": "number",
      "default": 0
    },
    "total_funded": {
      "type": "number",
      "default": 0
    },
    "total_withdrawn": {
      "type": "number",
      "default": 0
    },
    "momo_number": {
      "type": "string"
    },
    "preferred_payment": {
      "type": "string",
      "enum": [
        "mtn_momo",
        "telecel_cash",
        "bank_transfer",
        "card"
      ],
      "default": "mtn_momo"
    }
  },
  "required": [
    "user_email"
  ]
}