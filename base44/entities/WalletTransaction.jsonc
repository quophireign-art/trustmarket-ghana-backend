{
  "name": "WalletTransaction",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "fund",
        "withdraw",
        "payment",
        "gift_sent",
        "gift_received",
        "listing_fee",
        "susu_contribution",
        "susu_payout",
        "delivery_fee"
      ]
    },
    "amount": {
      "type": "number"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "failed"
      ],
      "default": "completed"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "mtn_momo",
        "telecel_cash",
        "bank_transfer",
        "card"
      ]
    },
    "reference": {
      "type": "string"
    }
  },
  "required": [
    "user_email",
    "type",
    "amount"
  ]
}