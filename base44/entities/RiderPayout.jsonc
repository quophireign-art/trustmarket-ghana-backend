{
  "name": "RiderPayout",
  "type": "object",
  "properties": {
    "rider_id": {
      "type": "string",
      "description": "ID of the rider this payout belongs to"
    },
    "rider_email": {
      "type": "string"
    },
    "rider_name": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "description": "Total commission amount paid out in GHS"
    },
    "delivery_count": {
      "type": "number",
      "default": 0,
      "description": "Number of completed deliveries covered by this payout"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "paid"
      ],
      "default": "pending"
    },
    "payout_method": {
      "type": "string",
      "enum": [
        "mtn_momo",
        "telecel_cash",
        "bank_transfer"
      ],
      "default": "mtn_momo"
    },
    "payout_number": {
      "type": "string",
      "description": "Phone or account number the payout was sent to"
    },
    "reference": {
      "type": "string",
      "description": "Transaction / MoMo reference for the completed payout"
    }
  },
  "required": [
    "rider_id",
    "rider_email",
    "amount"
  ]
}