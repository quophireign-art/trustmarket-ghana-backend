{
  "name": "SusuGroup",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C"
      ],
      "description": "A=50/day, B=500/day, C=5000/day (single-person plan)"
    },
    "daily_amount": {
      "type": "number",
      "description": "Fixed daily contribution for this category in GHS"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "active",
        "completed"
      ],
      "default": "open"
    }
  },
  "required": [
    "name",
    "category",
    "daily_amount"
  ]
}