{
  "name": "SellerProfile",
  "type": "object",
  "properties": {
    "email": {
      "type": "string"
    },
    "business_name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "ghana_card_url": {
      "type": "string",
      "description": "Uploaded Ghana Card image"
    },
    "business_doc_url": {
      "type": "string",
      "description": "Business registration document"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "unverified",
        "pending",
        "verified",
        "rejected"
      ],
      "default": "unverified"
    },
    "badge_level": {
      "type": "string",
      "enum": [
        "none",
        "bronze",
        "silver",
        "gold"
      ],
      "default": "none"
    },
    "total_sales": {
      "type": "number",
      "default": 0
    },
    "avg_rating": {
      "type": "number",
      "default": 0
    },
    "social_links": {
      "type": "object",
      "description": "Linked social media handles for cross-platform live announcements",
      "properties": {
        "facebook": {
          "type": "string"
        },
        "tiktok": {
          "type": "string"
        },
        "instagram": {
          "type": "string"
        },
        "youtube": {
          "type": "string"
        },
        "snapchat": {
          "type": "string"
        },
        "threads": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "email"
  ]
}