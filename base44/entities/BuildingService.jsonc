{
  "title": "BuildingService",
  "description": "Building & Trades professional services in Ghana",
  "type": "object",
  "properties": {
    "title": { "type": "string", "maxLength": 200, "required": true },
    "serviceType": { "type": "string", "enum": ["Architectural Design", "Building Contractor", "Carpentry & Joinery", "Electrical Installation", "Flooring Specialist", "Glass & Aluminium Works", "HVAC Services", "Landscaping", "Masonry", "Painting & Decorating", "Plumbing", "Renovation & Remodeling", "Roofing Specialist", "Steel Works & Welding", "Surveying", "Tiling", "Waterproofing", "Other"], "required": true },
    "price": { "type": "number", "minimum": 0, "required": true },
    "pricingType": { "type": "string", "enum": ["Fixed", "Per Square Meter", "Per Hour", "Per Day", "Negotiable", "Quote on Request"], "default": "Fixed" },
    "negotiable": { "type": "boolean", "default": false },
    "experienceYears": { "type": "number", "minimum": 0 },
    "location": { "type": "string", "maxLength": 200, "required": true },
    "region": { "type": "string", "maxLength": 100 },
    "serviceArea": { "type": "string", "maxLength": 500 },
    "description": { "type": "string", "maxLength": 5000 },
    "images": { "type": "array", "items": { "type": "string" } },
    "providerName": { "type": "string", "maxLength": 200, "required": true },
    "providerPhone": { "type": "string", "maxLength": 20 },
    "providerEmail": { "type": "string", "maxLength": 200 },
    "businessType": { "type": "string", "enum": ["Individual", "Company", "Cooperative"], "default": "Individual" },
    "licensed": { "type": "boolean", "default": false },
    "insurance": { "type": "boolean", "default": false },
    "portfolio": { "type": "array", "items": { "type": "string" } },
    "availability": { "type": "string", "maxLength": 200 },
    "featured": { "type": "boolean", "default": false },
    "status": { "type": "string", "enum": ["active", "inactive", "booked"], "default": "active" },
    "listingType": { "type": "string", "enum": ["standard", "premium"], "default": "standard" }
  }
}