{
  "name": "SellerPresence",
  "type": "object",
  "properties": {
    "seller_email": {
      "type": "string",
      "description": "Seller's email address"
    },
    "last_seen": {
      "type": "string",
      "description": "ISO timestamp of last activity"
    },
    "is_online": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "seller_email"
  ]
}