{
  "title": "CVProfile",
  "description": "Seeking Work / CV Marketplace profiles in Ghana",
  "type": "object",
  "properties": {
    "title": { "type": "string", "maxLength": 200, "required": true },
    "fullName": { "type": "string", "maxLength": 200, "required": true },
    "profession": { "type": "string", "maxLength": 100, "required": true },
    "experienceYears": { "type": "number", "minimum": 0, "required": true },
    "jobTypeSought": { "type": "string", "enum": ["Full-time", "Part-time", "Contract", "Temporary", "Internship", "Remote", "Freelance", "Any"], "default": "Any" },
    "industries": { "type": "array", "items": { "type": "string" } },
    "skills": { "type": "array", "items": { "type": "string" } },
    "educationLevel": { "type": "string", "enum": ["Basic Education", "SHS / WASSCE", "Diploma", "HND", "Bachelor Degree", "Masters", "PhD", "Professional Certification", "Vocational Training"], "default": "Bachelor Degree" },
    "educationDetails": { "type": "string", "maxLength": 1000 },
    "certifications": { "type": "array", "items": { "type": "string" } },
    "languages": { "type": "array", "items": { "type": "string" } },
    "expectedSalary": { "type": "number", "minimum": 0 },
    "salaryCurrency": { "type": "string", "enum": ["GHS", "USD"], "default": "GHS" },
    "salaryPeriod": { "type": "string", "enum": ["Per Hour", "Per Day", "Per Week", "Per Month", "Per Year"], "default": "Per Month" },
    "negotiable": { "type": "boolean", "default": true },
    "location": { "type": "string", "maxLength": 200, "required": true },
    "region": { "type": "string", "maxLength": 100 },
    "willingToRelocate": { "type": "boolean", "default": false },
    "bio": { "type": "string", "maxLength": 5000 },
    "profileImage": { "type": "string" },
    "cvUrl": { "type": "string" },
    "portfolioUrl": { "type": "string" },
    "linkedinUrl": { "type": "string" },
    "phone": { "type": "string", "maxLength": 20 },
    "email": { "type": "string", "maxLength": 200 },
    "featured": { "type": "boolean", "default": false },
    "status": { "type": "string", "enum": ["active", "hired", "inactive"], "default": "active" },
    "listingType": { "type": "string", "enum": ["standard", "premium"], "default": "standard" }
  }
}