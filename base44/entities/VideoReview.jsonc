{
  "name": "VideoReview",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string",
      "description": "ID of the product being reviewed"
    },
    "product_title": {
      "type": "string"
    },
    "reviewer_email": {
      "type": "string"
    },
    "reviewer_name": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "description": "Rating 1-5"
    },
    "caption": {
      "type": "string",
      "description": "Short text caption for the video review"
    },
    "video_url": {
      "type": "string",
      "description": "Uploaded video file URL"
    },
    "thumbnail_url": {
      "type": "string",
      "description": "Optional poster/thumbnail image URL"
    }
  },
  "required": [
    "product_id",
    "reviewer_email",
    "rating",
    "video_url"
  ]
}