{
  "name": "ProductFollow",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the user following the product"
    },
    "product_id": {
      "type": "string",
      "description": "ID of the followed product"
    },
    "product_title": {
      "type": "string"
    },
    "price_at_follow": {
      "type": "number",
      "description": "Price when user followed \u2014 used to detect drops"
    }
  },
  "required": [
    "user_email",
    "product_id",
    "price_at_follow"
  ]
}