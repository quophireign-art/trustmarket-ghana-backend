{
  "title": "Pet",
  "description": "Animals & Pets for sale, adoption and breeding in Ghana",
  "type": "object",
  "properties": {
    "title": { "type": "string", "maxLength": 200, "required": true },
    "category": { "type": "string", "enum": ["Dogs", "Cats", "Birds", "Fish & Aquarium", "Livestock", "Poultry", "Rabbits", "Guinea Pigs", "Reptiles", "Horses", "Pet Food", "Pet Accessories", "Pet Grooming", "Pet Training", "Veterinary Services", "Breeding Services", "Pet Boarding", "Other"], "required": true },
    "breed": { "type": "string", "maxLength": 100 },
    "age": { "type": "string", "maxLength": 50 },
    "gender": { "type": "string", "enum": ["Male", "Female", "Not Specified"], "default": "Not Specified" },
    "color": { "type": "string", "maxLength": 50 },
    "vaccinated": { "type": "boolean", "default": false },
    "dewormed": { "type": "boolean", "default": false },
    "healthChecked": { "type": "boolean", "default": false },
    "price": { "type": "number", "minimum": 0, "required": true },
    "negotiable": { "type": "boolean", "default": false },
    "listingPurpose": { "type": "string", "enum": ["For Sale", "For Adoption", "For Breeding", "Lost & Found", "Stud Service"], "default": "For Sale" },
    "location": { "type": "string", "maxLength": 200, "required": true },
    "region": { "type": "string", "maxLength": 100 },
    "description": { "type": "string", "maxLength": 5000 },
    "images": { "type": "array", "items": { "type": "string" } },
    "sellerName": { "type": "string", "maxLength": 200 },
    "sellerPhone": { "type": "string", "maxLength": 20 },
    "sellerEmail": { "type": "string", "maxLength": 200 },
    "sellerType": { "type": "string", "enum": ["Individual", "Breeder", "Pet Shop", "Veterinary Clinic", "Farm"], "default": "Individual" },
    "papersAvailable": { "type": "boolean", "default": false },
    "deliveryAvailable": { "type": "boolean", "default": false },
    "featured": { "type": "boolean", "default": false },
    "status": { "type": "string", "enum": ["active", "sold", "adopted", "reserved", "inactive"], "default": "active" },
    "listingType": { "type": "string", "enum": ["standard", "premium", "auction"], "default": "standard" }
  }
}