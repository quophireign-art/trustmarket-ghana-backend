# TrustMarket Ghana (Tiko Ghana) — Backend Environment Variables
#
# Copy this file to .env and fill in your real values.
#   cp .env.example .env
#
# ⚠️  NEVER commit .env to version control!
# ⚠️  For production hosting (Render/Railway), set these as
#     Environment Variables in the hosting dashboard.

# ---- Core ----
PORT=8787
NODE_ENV=development

# ---- Frontend Origin (CORS) ----
# Comma-separated list of allowed origins.
FRONTEND_ORIGIN=http://localhost:5173

# ---- Public Backend URL ----
# Used to build file upload URLs and CSP headers.
PUBLIC_BACKEND_URL=http://localhost:8787

# ---- Paystack (Payments) ----
# Get your keys at https://dashboard.paystack.com
# Use sk_test_ for development, sk_live_ for production
PAYSTACK_SECRET_KEY=sk_test_your_paystack_test_key_here

# ---- Arkesel (SMS) ----
# Get your key at https://arkesel.com
ARKESEL_API_KEY=your_arkesel_api_key_here

# ---- Anthropic AI (Optional) ----
ANTHROPIC_API_KEY=

# ---- Google Maps (Optional) ----
GOOGLE_MAPS_API_KEY=

# ---- Smile Identity — Ghana Card KYC (Optional) ----
SMILE_PARTNER_ID=
SMILE_API_KEY=
SMILE_SIGNATURE=

# ---- Resend — Transactional Email (Optional) ----
RESEND_API_KEY=

# ---- OneSignal — Push Notifications (Optional) ----
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
